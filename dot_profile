export EDITOR=vim

# Load ~/.config/environment.d/*.conf (normally only read by systemd --user)
if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d" ]; then
    set -a
    for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf; do
        [ -r "$f" ] && . "$f"
    done
    set +a
fi

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

if [ -e $HOME/.nix-profile/etc/profile.d/nix.sh ] ; then
    . $HOME/.nix-profile/etc/profile.d/nix.sh
fi

if [ -z $XDG_DATA_DIRS ] && [ -d /usr/share ] ; then
    export XDG_DATA_DIRS=/usr/share
fi

