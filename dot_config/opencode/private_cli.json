{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "<leader>p"
  },
  "leader": {
    "timeout": 2000
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
