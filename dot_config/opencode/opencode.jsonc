{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "provider": {
    "openrouter": {
      "models": {
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "order": ["minimax/highspeed"]
            }
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-571faf44-cc73-4969-9888-40bb84bd5ed5"
      }
    }
  }
}
