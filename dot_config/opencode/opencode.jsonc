{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/deepseek-v4-flash",
  "plugin": [
    "@prevalentware/opencode-goal-plugin",
    "opencode-history-search"
  ],
  "formatter": true,
  "plugin": [
    ["./plugins/docs-update/index.ts", { "skill": "docs-update" }]
  ],
  "provider": {
    "openrouter": {
      "models": {
        "minimax/minimax-m2.7": {
          "options": {
            "provider": {
              "order": ["minimax/highspeed"]
            }
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "permission": {
        "bash": {
          "*": "deny",
          "git": "allow",
          "git *": "allow",
          "git memory-clone *": "allow"
        },
        "external_directory": {
          "*": "deny",
          "/tmp/opencode-explore-*": "allow",
          "/tmp/opencode-explore-*/**": "allow"
        },
        "skill": {
          "*": "deny",
          "memory-clone": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "git": "allow",
          "git *": "allow",
          "git memory-clone *": "allow"
        },
        "external_directory": {
          "*": "ask",
          "/tmp/opencode-explore-*": "allow",
          "/tmp/opencode-explore-*/**": "allow"
        },
        "skill": {
          "memory-clone": "allow"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-571faf44-cc73-4969-9888-40bb84bd5ed5"
      }
    }
  }
}
