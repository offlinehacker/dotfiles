[Unit]
Description=OpenCode Server
After=network.target

[Service]
Type=simple
# Required for agent to run secretspec
Environment="SECRETSPEC_REASON=opencode agent access"
# V2 registers the foreground process for CLI service discovery.
# Plugins are managed by `opencode plugin update`, not the v1 cache updater.
ExecStart=/home/linuxbrew/.linuxbrew/bin/opencode serve --service --hostname=0.0.0.0 --port 4096 --cors *
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
