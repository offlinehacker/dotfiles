[Unit]
Description=OpenChamber web server
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/openchamber/startup.env
ExecStart=%h/.bun/bin/openchamber serve --foreground --port 3000 --host 0.0.0.0 --api-only
WorkingDirectory=/home/offlinehq
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
