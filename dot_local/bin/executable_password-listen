#!/usr/bin/env bash
# Run this in your own interactive terminal and leave it running.
# It hosts pinentry-tty (the actual UI backend), using this terminal as
# its controlling tty, while its Assuan control channel (stdin/stdout) is
# redirected to a pair of FIFOs. `password-ask` (run elsewhere, e.g. by an
# agent with no tty of its own) connects to those FIFOs to drive it, so
# any password prompt always appears here, in a terminal you control.
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
FIFO_IN="$RUNTIME_DIR/password_ask_in"
FIFO_OUT="$RUNTIME_DIR/password_ask_out"
PINENTRY_BIN="${PINENTRY_BIN:-pinentry-tty}"

umask 177
[[ -p "$FIFO_IN" ]] || mkfifo -m 600 "$FIFO_IN"
[[ -p "$FIFO_OUT" ]] || mkfifo -m 600 "$FIFO_OUT"

MY_TTY="$(tty)"
MY_LC_CTYPE="${LC_CTYPE:-${LC_ALL:-${LANG:-en_US.UTF-8}}}"
read -r LINES COLUMNS < <(stty size)
export LINES COLUMNS

show_waiting() {
    tput clear > "$MY_TTY" 2>/dev/null || true
    echo "password-listen: waiting for prompt requests (Ctrl+C to stop)..." > "$MY_TTY"
}

show_waiting
while true; do
    read -r LINES COLUMNS < <(stty size)
    export LINES COLUMNS
    "$PINENTRY_BIN" --ttyname="$MY_TTY" --lc-ctype="$MY_LC_CTYPE" < "$FIFO_IN" > "$FIFO_OUT" || true
    show_waiting
done
