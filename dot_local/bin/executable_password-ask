#!/usr/bin/env bash
# Requests a password/secret from you via pinentry-tty hosted by
# `password-listen` (running in your terminal), over a pair of FIFOs,
# using the Assuan protocol. Prints the entered value to stdout;
# everything else goes to stderr. Has no knowledge of what the secret is
# for — generic primitive for any tool that needs an interactive prompt
# while running headlessly (e.g. no tty of its own).
#
# Usage: password-ask [--title TITLE] [--desc DESC] [--prompt PROMPT]
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
FIFO_IN="$RUNTIME_DIR/password_ask_in"
FIFO_OUT="$RUNTIME_DIR/password_ask_out"
LOCK_FILE="$RUNTIME_DIR/password_ask.lock"

TITLE="Secret Prompt"
DESC="Enter the requested value"
PROMPT="Value:"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --title) TITLE="$2"; shift 2 ;;
        --desc) DESC="$2"; shift 2 ;;
        --prompt) PROMPT="$2"; shift 2 ;;
        *) echo "password-ask: unknown argument: $1" >&2; exit 1 ;;
    esac
done

die() { echo "password-ask: $*" >&2; exit 1; }

urlencode() {
    local s="$1" out="" c i
    for (( i=0; i<${#s}; i++ )); do
        c="${s:$i:1}"
        case "$c" in
            [a-zA-Z0-9.~_-]) out+="$c" ;;
            *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
        esac
    done
    printf '%s' "$out"
}

decode_assuan() {
    # Decode Assuan %XX percent-escaping used in D lines.
    local s="$1"
    printf '%s' "$s" | sed -E 's/%([0-9A-Fa-f]{2})/\\x\1/g' | xargs -0 printf '%b'
}

[[ -p "$FIFO_IN" && -p "$FIFO_OUT" ]] || die "listener not running; start 'password-listen' in your terminal first"

# Serialize concurrent callers: only one Assuan conversation over the
# shared FIFOs at a time.
exec 9>"$LOCK_FILE"
flock 9

# Open IN before OUT to match the listener's redirection order and avoid deadlock.
exec 3>"$FIFO_IN"
exec 4<"$FIFO_OUT"

send() { printf '%s\n' "$1" >&3; }
expect_ok() {
    local line
    read -r line <&4
    [[ "$line" == OK* ]] || die "pinentry protocol error: $line"
}

read -r _ <&4                                # initial "OK Pleased to meet you"
send "OPTION ttytype=${TERM:-xterm-256color}"; expect_ok
send "SETTITLE $(urlencode "$TITLE")";        expect_ok
send "SETDESC $(urlencode "$DESC")";          expect_ok
send "SETPROMPT $(urlencode "$PROMPT")";      expect_ok
send "GETPIN"

value=""
while read -r line <&4; do
    case "$line" in
        D\ *) value="$(decode_assuan "${line#D }")" ;;
        OK*) break ;;
        ERR*)
            send "BYE" 2>/dev/null || true
            die "pinentry: $line"
            ;;
    esac
done
send "BYE" 2>/dev/null || true
exec 3>&- 4<&-
flock -u 9

[[ -n "$value" ]] || die "no value entered"
printf '%s' "$value"
